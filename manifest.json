{
  "name": "Copy as plain text",
  "manifest_version": 3,
  "description": "",
  "version": "0.3",
  "action": {
    "default_popup": "./popup.html"
  },
  "background": {
    "service_worker": "./dist/background/background.mjs",
    "type": "module"
  },
  "icons": {
    "32": "./assets/icons/icon-32.png",
    "64": "./assets/icons/icon-64.png",
    "128": "./assets/icons/icon-128.png",
    "256": "./assets/icons/icon-256.png"
  },
  "permissions": [
    "activeTab",
    "clipboardWrite",
    "scripting",
    "storage",
    "offscreen"
  ],
  "optional_permissions": [
    "contextMenus",
    "clipboardRead"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["./dist/content_scripts/last_interaction.js", "./dist/content_scripts/always_CaPT.js"],
      "all_frames": true,
      "match_origin_as_fallback": true,
      "match_about_blank": true
    }
  ],
  "web_accessible_resources": [],
  "commands": {
    "copy-as-plain-text": {
      "suggested_key": {
        "default": "Ctrl+Shift+C"
      },
      "description": "Copy as plain text"
    },
    "cut-as-plain-text": {
      "suggested_key": {
        "default": "Ctrl+Shift+X"
      },
      "description": "Cut as plain text"
    }
  }
}